# Cloudflare cache strategy — deploys appear instantly, no hard-refresh ever needed.
#
# WHY: Cloudflare caches .css/.js by file EXTENSION with a 4-hour minimum that a _headers
# no-cache rule cannot lower. The robust, industry-standard fix is CONTENT-HASHED FILENAMES
# (styles.<hash>.css, main.<hash>.js): any change produces a brand-new filename, so the old
# cached copy is irrelevant and the new file — never seen before — is fetched immediately.
# The HTML (never cached) always points at the current hashed filenames.

# HTML: never cache — always fetch fresh so it points at the latest hashed assets.
/
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# JSON content: revalidate every request (also fetched with cache:'no-cache' in JS).
/*.json
  Cache-Control: no-cache, must-revalidate

# version.json: belt-and-suspenders — auto-update probe must never be stale.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker file: must never be cached so browsers detect new SW versions.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# PDFs: open inline in the browser's PDF viewer instead of forcing a download.
/*.pdf
  Content-Disposition: inline
  Cache-Control: public, max-age=3600

# Hashed CSS/JS: safe to cache forever — the filename changes whenever the content does.
/styles.*.css
  Cache-Control: public, max-age=31536000, immutable
/main.*.js
  Cache-Control: public, max-age=31536000, immutable

# Static media: cache for a day.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
